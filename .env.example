# Copy to .env (gitignored) and fill in. Never commit .env.
#
# Optional: only needed to re-pull raw data from BigQuery.
# Reproducing the figures from the committed snapshots needs no accounts or keys.
#
# Authenticate once with Application Default Credentials (no key file needed):
#   gcloud auth application-default login
# The sandbox (no billing) is enough; every query is dry-run first and guarded by --max-gb.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
